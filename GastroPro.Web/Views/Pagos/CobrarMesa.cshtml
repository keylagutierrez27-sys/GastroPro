@model GastroPro.Domain.Entities.Pago

@{
    ViewData["Title"] = "Cierre de Cuenta";
}

<div class="card shadow mx-auto mt-4" style="max-width: 500px;">
    <div class="card-header bg-dark text-warning py-3 text-center">
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-file-invoice-dollar"></i> Cobrar Mesa #@Model.NumeroMesa</h4>
    </div>
    <div class="card-body p-4">

        <form asp-controller="Pagos" asp-action="ProcesarPago" method="post">
            @Html.AntiForgeryToken()

            @* AQUI COLOQUÉ EL RESUMEN DE ERRORES: Si algo falla, aparecerá aquí *@
            <div asp-validation-summary="All" class="alert alert-danger p-2 small"></div>

            <input type="hidden" asp-for="NumeroMesa" />
            <input type="hidden" asp-for="TotalPagado" />

            <div class="text-center my-4 bg-light p-3 rounded border">
                <span class="text-muted text-uppercase small fw-bold">Total Neto a Pagar</span>
                <h1 class="display-5 fw-bold text-success mt-1">S/ @Model.TotalPagado.ToString("F2")</h1>
            </div>

            <div class="mb-3">
                <label asp-for="MetodoPago" class="form-label fw-bold">Medio de Pago</label>
                <select asp-for="MetodoPago" class="form-select form-select-lg border-success">
                    <option value="">-- Seleccionar método de pago --</option>
                    <option value="Efectivo" selected>💵 Efectivo</option>
                    <option value="Yape">📱 Yape</option>
                    <option value="Plin">📱 Plin</option>
                    <option value="Tarjeta">💳 Tarjeta Crédito/Débito</option>
                </select>
                <span asp-validation-for="MetodoPago" class="text-danger small d-block mt-1"></span>
            </div>

            <div class="mb-4">
                <label asp-for="NroOperacion" class="form-label text-muted small">Número de Operación / Celular (Opcional)</label>
                <input asp-for="NroOperacion" class="form-control" placeholder="Ej. 013452" />
            </div>

            <div class="d-flex justify-content-between pt-2">
                <a asp-controller="Pedidos" asp-action="Index" class="btn btn-outline-secondary">Regresar</a>
                <button type="submit" class="btn btn-success btn-lg px-4 fw-bold">Confirmar e Imprimir</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}