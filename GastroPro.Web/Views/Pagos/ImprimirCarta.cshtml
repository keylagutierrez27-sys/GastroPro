@model IEnumerable<GastroPro.Domain.Entities.Pago>
@* NOTA: Aquí puedes cambiar el @model por tu entidad de "Plato" o "Producto" si ya la tienes creada,
   por ejemplo: @model IEnumerable<GastroPro.Domain.Entities.Producto> *@

@{
    ViewData["Title"] = "Carta Oficial - GastroPro";
}

<div class="container my-4 c-no-print">
    <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded border shadow-sm">
        <div>
            <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-utensils text-primary me-2"></i> Vista Previa de la Carta</h5>
            <small class="text-muted">Diseño optimizado para impresión física en hojas A4.</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i> Volver a Gestión
            </a>
            <button onclick="window.print();" class="btn btn-sm btn-dark fw-bold px-4 shadow-sm">
                <i class="fa-solid fa-print me-1"></i> Imprimir Carta Ahora
            </button>
        </div>
    </div>
</div>

<div class="menu-board mx-auto p-5 my-4 shadow" id="cartaComercial">

    <div class="menu-header text-center mb-5">
        <h1 class="display-4 fw-bold mb-1 letter-spacing-2"><i class="fa-solid fa-fire-burner text-warning"></i> GASTROPRO</h1>
        <div class="menu-divider mb-2"></div>
        <p class="text-uppercase tracking-wide small mb-0 font-monospace">Caldería & Arroz Chaufa • Sabor Tradicional</p>
        <small class="text-muted italic">Ayacucho, Perú</small>
    </div>

    <div class="row g-5">

        <div class="col-6">
            <div class="menu-section mb-4">
                <h4 class="section-title text-uppercase fw-bold mb-3"><i class="fa-solid fa-bowl-food me-2"></i> Los Especiales de la Casa</h4>

                <div class="menu-item d-flex justify-content-between align-items-baseline mb-2">
                    <span class="item-name fw-bold">Caldo de Gallina Concentrado</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 14.00</span>
                </div>
                <p class="item-description text-muted small mb-3">Fideos, huevo duro, papa amarilla y presa mediana de gallina seleccionada.</p>

                <div class="menu-item d-flex justify-content-between align-items-baseline mb-2">
                    <span class="item-name fw-bold">Caldo de Gallina Especial</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 18.00</span>
                </div>
                <p class="item-description text-muted small mb-3">Porción doble de fideos, papa amarilla, huevo duro y presa grande (pechuga/pierna).</p>

                <div class="menu-item d-flex justify-content-between align-items-baseline mb-2">
                    <span class="item-name fw-bold">Caldo "Levanta Muertos"</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 22.00</span>
                </div>
                <p class="item-description text-muted small mb-3">Caldo especial de la casa repotenciado con mollejas, hígados picados y jengibre.</p>
            </div>

            <div class="menu-section mb-4">
                <h4 class="section-title text-uppercase fw-bold mb-3"><i class="fa-solid fa-fire text-danger me-2"></i> Delicias al Wok</h4>

                <div class="menu-item d-flex justify-content-between align-items-baseline mb-2">
                    <span class="item-name fw-bold">Arroz Chaufa de Pollo Clásico</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 15.00</span>
                </div>
                <p class="item-description text-muted small mb-3">Salteado a fuego vivo con trozos de pollo, cebollita china, huevo y el secreto del chef.</p>

                <div class="menu-item d-flex justify-content-between align-items-baseline mb-2">
                    <span class="item-name fw-bold">Arroz Chaufa de Carne</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 18.00</span>
                </div>
                <p class="item-description text-muted small mb-3">Sazonado al wok con finos trozos de carne de res, pimientos y tortillas de huevo.</p>

                <div class="menu-item d-flex justify-content-between align-items-baseline mb-2">
                    <span class="item-name fw-bold">Arroz Chaufa Especial</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 24.00</span>
                </div>
                <p class="item-description text-muted small mb-3">Combinación contundente de pollo, carne de res y cecina ahumada de la selva.</p>
            </div>
        </div>

        <div class="col-6">
            <div class="menu-section mb-4">
                <h4 class="section-title text-uppercase fw-bold mb-3"><i class="fa-solid fa-plate-wheat me-2"></i> Los Combinados</h4>

                <div class="menu-item d-flex justify-content-between align-items-baseline mb-2">
                    <span class="item-name fw-bold">El Combinado Clásico</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 18.00</span>
                </div>
                <p class="item-description text-muted small mb-3">Mitad porción de Arroz Chaufa de pollo y mitad Tallarín Saltado criollo al wok.</p>

                <div class="menu-item d-flex justify-content-between align-items-baseline mb-2">
                    <span class="item-name fw-bold">El "Monstruo" de la Casa</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 22.00</span>
                </div>
                <p class="item-description text-muted small mb-3">Montaña de Arroz Chaufa de pollo acompañada de una crujiente milanesa o broaster.</p>
            </div>

            <div class="menu-section mb-4">
                <h4 class="section-title text-uppercase fw-bold mb-3"><i class="fa-solid fa-bacon text-warning me-2"></i> Entradas & Porciones</h4>

                <div class="menu-item d-flex justify-content-between align-items-baseline mb-2">
                    <span class="item-name fw-bold">Tequeños de Queso (6 unidades)</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 10.00</span>
                </div>
                <p class="item-description text-muted small mb-3">Crujientes tequeños rellenos de queso, acompañados de crema huancaína.</p>

                <div class="menu-item d-flex justify-content-between align-items-baseline mb-2">
                    <span class="item-name fw-bold">Papas Fritas Tumbay</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 8.00</span>
                </div>
                <p class="item-description text-muted small mb-3">Papas nativas amarillas fritas, crujientes por fuera y suaves por dentro.</p>
            </div>

            <div class="menu-section mb-4">
                <h4 class="section-title text-uppercase fw-bold mb-3"><i class="fa-solid fa-glass-water text-info me-2"></i> Bebidas & Refrescos</h4>

                <div class="menu-item d-flex justify-content-between align-items-baseline mb-1">
                    <span class="item-name fw-bold">Jarra de Chicha Morada (1 L)</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 10.00</span>
                </div>
                <div class="menu-item d-flex justify-content-between align-items-baseline mb-1">
                    <span class="item-name fw-bold">Jarra de Maracuyá Natural (1 L)</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 9.00</span>
                </div>
                <div class="menu-item d-flex justify-content-between align-items-baseline mb-1">
                    <span class="item-name fw-bold">Gaseosa Mediana (500ml)</span>
                    <span class="item-dots"></span>
                    <span class="item-price fw-bold">S/ 4.00</span>
                </div>
            </div>
        </div>

    </div>

    <div class="text-center mt-5 pt-4 border-top border-light">
        <p class="small mb-0 text-secondary italic">Todos nuestros platos se preparan al instante garantizando la máxima frescura. ¡Buen provecho!</p>
        <span class="font-monospace text-muted" style="font-size: 11px;">GastroPro - Control Digital de Cartas</span>
    </div>

</div>

<style>
    .menu-board {
        background-color: #ffffff;
        color: #1a1a1a;
        max-width: 800px;
        border: 2px solid #2c3e50;
        border-radius: 4px;
        font-family: 'Georgia', serif;
    }

    .letter-spacing-2 {
        letter-spacing: 2px;
        color: #111111;
    }

    .menu-divider {
        height: 3px;
        width: 120px;
        background-color: #ffc107;
        margin: 0 auto;
    }

    .section-title {
        font-size: 1.1rem;
        color: #002347; /* Azul marino elegante */
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 5px;
        letter-spacing: 1px;
    }

    .item-name {
        font-size: 1rem;
        color: #222222;
        padding-right: 5px;
        background: #fff;
    }

    .item-price {
        font-size: 1rem;
        color: #111111;
        padding-left: 5px;
        background: #fff;
    }

    /* Generador automático de puntitos conectores (efecto menú clásico) */
    .item-dots {
        flex-grow: 1;
        border-bottom: 2px dotted #cccccc;
        position: relative;
        top: -4px;
    }

    .item-description {
        font-family: 'Arial', sans-serif;
        color: #6c757d;
        line-height: 1.3;
        margin-top: -2px;
    }

    /* 🖨️ CONTROL TOTAL DE IMPRESIÓN (FORMATO A4 RECTO) */
    @@media print {
        body * {
            visibility: hidden;
            background: transparent !important;
        }

        .c-no-print {
            display: none !important; /* Oculta botones y alertas */
        }

        #cartaComercial, #cartaComercial * {
            visibility: visible;
        }

        #cartaComercial {
            position: absolute;
            left: 0;
            top: 0;
            width: 100% !important;
            max-width: 210mm !important; /* Ancho real de hoja A4 */
            border: none !important;
            box-shadow: none !important;
            padding: 20mm !important; /* Margen físico de imprenta */
            margin: 0 !important;
        }

        .item-dots {
            border-bottom: 2px dotted #666666 !important; /* Forzar que salgan los puntitos al imprimir */
        }

        @@page {
            size: A4;
            margin: 10mm 0mm 10mm 0mm; /* Elimina URL de las esquinas */
        }
    }
</style>