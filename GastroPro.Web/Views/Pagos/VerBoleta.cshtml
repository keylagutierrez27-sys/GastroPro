@model GastroPro.Domain.Entities.Pago

@{
    ViewData["Title"] = "Boleta Electrónica";
}

<div class="container d-flex flex-column align-items-center mt-4">
    
    <div class="d-flex gap-3 mb-4 w-100 justify-content-center c-no-print">
        <a asp-controller="Pagos" asp-action="Index" class="btn btn-sm btn-outline-secondary shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver a Caja
        </a>
        <button onclick="window.print();" class="btn btn-sm btn-success fw-bold px-4 shadow-sm">
            <i class="fa-solid fa-print me-1"></i> Imprimir Comprobante (80mm)
        </button>
    </div>

    <div class="ticket bg-white p-4 shadow-sm border font-monospace text-dark mb-4" id="boletaTicket" style="width: 380px; font-size: 14px; border-top: 4px dashed #6c757d !important;">

        <div class="text-center mb-3">
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-fire-burner"></i> GASTROPRO</h4>
            <p class="small text-muted mb-0">CALDERÍA Y CHAUFA S.A.C.</p>
            <p class="small text-muted mb-0">Ayacucho, Perú</p>
            <p class="mb-0 mt-2 fw-bold">R.U.C. 20123456789</p>
        </div>

        <div class="border-top border-bottom border-secondary my-3 py-2">
            <p class="mb-1"><strong>BOLETA ELECTRÓNICA:</strong> #B001-@Model.PagoId.ToString("D5")</p>
            <p class="mb-1"><strong>FECHA:</strong> @Model.FechaPago.ToString("dd/MM/yyyy")</p>
            <p class="mb-1"><strong>HORA:</strong> @Model.FechaPago.ToString("hh:mm:ss tt")</p>
            <p class="mb-0"><strong>MESA ATENDIDA:</strong> MESA #@Model.NumeroMesa</p>
        </div>

        <div class="my-3">
            <table class="w-100 small">
                <thead>
                    <tr class="border-bottom border-secondary">
                        <th class="text-start pb-1">CONCEPTO</th>
                        <th class="text-end pb-1">TOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="pt-2 text-uppercase">Consumo de Alimentos (Mesa @Model.NumeroMesa)</td>
                        <td class="text-end pt-2 fw-bold">S/ @Model.TotalPagado.ToString("F2")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="border-top border-secondary pt-3 mt-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span>OP. GRAVADA:</span>
                <span>S/ @((Model.TotalPagado / 1.18m).ToString("F2"))</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span>I.G.V. (18%):</span>
                <span>S/ @((Model.TotalPagado - (Model.TotalPagado / 1.18m)).ToString("F2"))</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary fw-bold fs-5">
                <span>TOTAL A PAGAR:</span>
                <span class="text-success">S/ @Model.TotalPagado.ToString("F2")</span>
            </div>
        </div>

        <div class="mt-4 text-start bg-light p-2 rounded border small">
            <p class="mb-1"><strong>Forma de Pago:</strong> @Model.MetodoPago</p>
            @if (!string.IsNullOrEmpty(Model.NroOperacion))
            {
                <p class="mb-0"><strong>Ref/Operación:</strong> @Model.NroOperacion</p>
            }
        </div>

        <div class="text-center mt-4 border-top border-secondary border-dashed pt-3">
            <p class="mb-1 fw-bold">¡Gracias por su preferencia!</p>
            <p class="small text-muted mb-0">GastroPro - Control Digital de Comandas</p>
        </div>
    </div>
</div>

<style>
    /* 🖨️ Al poner doble @@ evitamos por completo el error CS0103 */
    @@media print {
        body * {
            visibility: hidden;
        }

        .c-no-print {
            display: none !important;
        }

        #boletaTicket, #boletaTicket * {
            visibility: visible;
        }

        #boletaTicket {
            position: absolute;
            left: 0;
            top: 0;
            width: 100% !important;
            max-width: 80mm !important; /* Forzado de estándar térmico industrial */
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }
    }

    /* Inyectamos el CSS de la página de forma segura como texto plano */
    @Html.Raw("@page { margin: 0; }")
</style>