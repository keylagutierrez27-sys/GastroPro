@model GastroPro.Domain.Entities.Pedido

@{
    ViewData["Title"] = "Actualizar Estado del Pedido";
}

<div class="card shadow mx-auto mt-5" style="max-width: 450px;">
    <div class="card-header bg-primary text-white py-3">
        <h5 class="mb-0 fw-bold"><i class="fa-solid fa-arrows-spin me-2"></i> Cambiar Estado de la Orden</h5>
    </div>
    <div class="card-body p-4">
        <div class="alert alert-secondary py-2 border-0">
            <p class="mb-1"><strong>Mesa:</strong> #@Model.NumeroMesa</p>
            <p class="mb-0"><strong>Plato:</strong> @Model.Plato?.Nombre (x@Model.Cantidad)</p>
        </div>

        <form asp-action="Edit">
            <input type="hidden" asp-for="PedidoId" />

            <div class="mb-4">
                <label class="form-label fw-bold text-secondary">Selecciona el flujo en cocina:</label>
                <select name="nuevoEstado" class="form-select form-select-lg border-primary">
                    @foreach (var estado in ViewBag.Estados as List<string>)
                    {
                        if (estado == Model.Estado)
                        {
                            <option value="@estado" selected>@estado</option>
                        }
                        else
                        {
                            <option value="@estado">@estado</option>
                        }
                    }
                </select>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Volver al monitor</a>
                <button type="submit" class="btn btn-primary px-4 fw-bold">Actualizar Estado</button>
            </div>
        </form>
    </div>
</div>