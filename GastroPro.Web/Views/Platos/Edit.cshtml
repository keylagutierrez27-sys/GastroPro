@model GastroPro.Domain.Entities.Plato

@{
    ViewData["Title"] = "Editar Plato";
}

<div class="card shadow-sm max-width-600 mx-auto mt-4" style="max-width: 500px;">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0 fw-bold"><i class="fas fa-edit"></i> Modificar Plato / Precio</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="PlatoId" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-bold">Nombre del Plato</label>
                <input asp-for="Nombre" class="form-control bg-light" readonly />
                <span class="form-text text-muted">El nombre no se puede modificar para proteger el historial de comandas.</span>
            </div>

            <div class="mb-3">
                <label asp-for="Precio" class="form-label fw-bold">Nuevo Precio (S/)</label>
                <input asp-for="Precio" type="number" step="0.1" class="form-control border-warning focus-ring" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Categoria" class="form-label fw-bold">Categoría</label>
                <input asp-for="Categoria" class="form-control bg-light" readonly />
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Regresar</a>
                <button type="submit" class="btn btn-warning text-dark fw-bold">Actualizar Precio</button>
            </div>
        </form>
    </div>
</div>