@model IEnumerable<GastroPro.Domain.Entities.Plato>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Menú de Platos";
    // Capturamos el rol que inició sesión actual
    var rolActivo = HttpContextAccessor.HttpContext?.Session.GetString("RolActivo") ?? "Ninguno";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary"><i class="fas fa-utensils"></i> Gestión del Menú</h2>

    @if (rolActivo == "Administrador")
    {
        <a asp-action="Create" class="btn btn-success shadow-sm"><i class="fas fa-plus"></i> Nuevo Plato</a>
    }
</div>

<table class="table table-hover table-striped shadow-sm rounded align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre del Plato</th>
            <th>Precio</th>
            <th>Categoría</th>
            <th class="text-center" style="width: 200px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PlatoId</td>
                <td class="fw-bold">@item.Nombre</td>
                <td class="text-primary fw-semibold">S/ @item.Precio.ToString("F2")</td>
                <td><span class="badge bg-secondary">@item.Categoria</span></td>
                <td class="text-center">
                    <div class="btn-group" role="group">
                        @if (rolActivo == "Administrador")
                        {
                            <a asp-action="Edit" asp-route-id="@item.PlatoId" class="btn btn-sm btn-outline-warning text-dark" title="Editar Precio">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.PlatoId" class="btn btn-sm btn-outline-danger" title="Eliminar Plato">
                                <i class="fas fa-trash-alt"></i> Borrar
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small px-2"><i class="fa-solid fa-lock text-warning me-1"></i> Solo Lectura</span>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>