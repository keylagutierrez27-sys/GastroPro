@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    // Capturamos el usuario de la sesión; si no se ha seleccionado ninguno, aparecerá como "Invitado"
    var usuarioActivo = HttpContextAccessor.HttpContext?.Session.GetString("UsuarioActivo") ?? "Invitado";
    var rolActivo = HttpContextAccessor.HttpContext?.Session.GetString("RolActivo") ?? "Ninguno";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GastroPro</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GastroPro.Web.styles.css" asp-append-version="true" />

    <style>
        /* Pequeño toque personalizado para mejorar la marca */
        .navbar-brand {
        font-weight: 700;
        letter-spacing: 0.5px;
        }

        .nav-link {
        transition: color 0.2s ease;
        }

        .nav-link:hover {
        color: #ffc107 !important; /* Resalta los enlaces en amarillo al pasar el mouse */
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-4 shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand text-warning" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-fire-burner me-2"></i>GastroPro
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">
                        @if (rolActivo == "Ninguno" || string.IsNullOrEmpty(rolActivo))
                        {
                            <li class="nav-item">
                                <span class="nav-link text-muted opacity-50 px-3" style="cursor: not-allowed;">
                                    <i class="fa-solid fa-utensils me-2 text-secondary"></i>Gestionar Platos <i class="fa-solid fa-lock text-warning small ms-1"></i>
                                </span>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-muted opacity-50 px-3" style="cursor: not-allowed;">
                                    <i class="fa-solid fa-clipboard-list me-2 text-secondary"></i>Ver Pedidos <i class="fa-solid fa-lock text-warning small ms-1"></i>
                                </span>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-muted opacity-50 px-3" style="cursor: not-allowed;">
                                    <i class="fa-solid fa-cash-register me-2 text-success"></i>Ver Caja <i class="fa-solid fa-lock text-warning small ms-1"></i>
                                </span>
                            </li>
                        }
                        else
                        {
                            @if (rolActivo == "Administrador" || rolActivo == "Mozo")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light px-3" asp-area="" asp-controller="Platos" asp-action="Index">
                                        <i class="fa-solid fa-utensils me-2 text-secondary"></i>Gestionar Platos
                                    </a>
                                </li>
                            }

                            @if (rolActivo == "Mozo" || rolActivo == "Administrador")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light px-3" asp-area="" asp-controller="Pedidos" asp-action="Index">
                                        <i class="fa-solid fa-clipboard-list me-2 text-secondary"></i>Ver Pedidos
                                    </a>
                                </li>
                            }

                            @if (rolActivo == "Cajero" || rolActivo == "Administrador")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light px-3" asp-area="" asp-controller="Pagos" asp-action="Index">
                                        <i class="fa-solid fa-cash-register me-2 text-success"></i>Ver Caja
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item">
                            <a class="nav-link btn btn-sm btn-outline-light text-white px-3 py-1 shadow-sm d-flex align-items-center gap-2" asp-controller="Usuarios" asp-action="Index" style="border-radius: 20px;">
                                <i class="fa-solid fa-circle-user text-warning fs-5"></i>
                                <span>@usuarioActivo</span>
                                <span class="badge @(rolActivo == "Administrador" ? "bg-danger" : rolActivo == "Cajero" ? "bg-success" : rolActivo == "Mozo" ? "bg-primary" : "bg-secondary") small" style="font-size: 10px; padding: 4px 8px;">@rolActivo</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-light py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - <span class="fw-bold text-dark">GastroPro</span> - Sistema de Gestión Gastronómica
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>